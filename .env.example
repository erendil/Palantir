# Palantír — variables d'environnement
#
#   cp .env.example .env   puis renseigner les valeurs.
#
# Le fichier .env est ignoré par Git : il ne doit JAMAIS être committé.
# Générer les secrets avec :  openssl rand -hex 32

TZ=Europe/Paris

# ── MQTT ─────────────────────────────────────────────────────────────────────
# Le mot de passe doit aussi être inscrit dans config/mosquitto/passwd :
#   docker run --rm -it -v "$PWD/config/mosquitto:/m" eclipse-mosquitto:2 \
#     mosquitto_passwd -c -b /m/passwd palantir <mot-de-passe>
MQTT_USER=palantir
MQTT_PASSWORD=

# ── Coordinateur Zigbee : SONOFF ZBBridge-P ──────────────────────────────────
# IP fixe obligatoire (réservation DHCP) : Zigbee2MQTT s'y connecte en TCP.
ZBBRIDGE_HOST=192.168.0.
ZBBRIDGE_PORT=8888

# Interface web de Zigbee2MQTT (8080 est souvent déjà pris sur un NAS Synology)
Z2M_PORT=8081
Z2M_AUTH_TOKEN=

# ── InfluxDB ─────────────────────────────────────────────────────────────────
INFLUXDB_USER=palantir
INFLUXDB_PASSWORD=
INFLUXDB_ORG=palantir
INFLUXDB_BUCKET=domotique
INFLUXDB_RETENTION=0
INFLUXDB_TOKEN=

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# ── Comptage électrique ──────────────────────────────────────────────────────
# Socomec DIRIS Digiware M-50 (IP fixe également)
DIRIS_HOST=192.168.0.
DIRIS_MODBUS_PORT=502
DIRIS_SNMP_COMMUNITY=public
