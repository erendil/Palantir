# Palantír — secrets Home Assistant
#
#   cp secrets.yaml.example secrets.yaml   puis renseigner.
#
# secrets.yaml est ignoré par Git.

# Position du site (course du soleil, prévision solaire, gel au potager)
home_latitude: 0.000000
home_longitude: 0.000000
home_elevation: 0

# InfluxDB — mêmes valeurs que dans .env
influxdb_host: influxdb
influxdb_token: ""
influxdb_org: palantir
influxdb_bucket: domotique

# Socomec DIRIS Digiware M-50
diris_host: 192.168.0.
diris_snmp_community: public
